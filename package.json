{
  "name": "n-plus-1-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "n1": "./bin/install.js",
    "n-plus-1": "./bin/install.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src/ --ext .ts,.tsx || true && prettier --check src/ || true",
    "n1:dev": "tsx server.ts",
    "n1:start": "node dist/server.cjs",
    "n1:bug-run": "node bin/install.js --diagnostics",
    "test": "npm run test:all",
    "test:unit": "vitest run tests/unit --reporter=json --outputFile=unit-report.json",
    "test:integration": "vitest run tests/integration --reporter=json --outputFile=integration-report.json",
    "test:e2e": "playwright test tests/e2e",
    "test:contract": "vitest run tests/contract --reporter=json --outputFile=contract-report.json",
    "test:docker": "docker compose -f docker-compose.yml config > /dev/null",
    "test:security": "npm audit --audit-level=critical",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:security && npm run test:docker"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "framer-motion": "^12.43.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "memjs": "^1.3.2",
    "motion": "^12.34.3",
    "mysql2": "^3.17.4",
    "octokit": "^5.0.5",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
